<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/layout_symbol_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_watchlist_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_watchlist_symbol"
            android:textAppearance="@style/TextAppearance.Basarat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            tools:text="ENGRO" />

        <TextView
            android:id="@+id/tv_watchlist_name"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_text_secondary"
            tools:text="Engro Corporation" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_watchlist_price"
        android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_watchlist_change"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="402.10" />

    <TextView
        android:id="@+id/tv_watchlist_change"
        android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_positive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_watchlist_favorite"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+1.24%" />

    <ImageView
        android:id="@+id/iv_watchlist_favorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove from watchlist"
        android:padding="9dp"
        android:src="@drawable/ic_favorite_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_basarat_green" />

</androidx.constraintlayout.widget.ConstraintLayout>
