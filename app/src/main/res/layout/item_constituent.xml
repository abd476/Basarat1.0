<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tv_constituent_rank"
        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_rank_other"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <!-- Symbol & Name Column -->
    <LinearLayout
        android:id="@+id/layout_constituent_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_constituent_price"
        app:layout_constraintStart_toEndOf="@id/tv_constituent_rank"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_constituent_symbol"
            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            tools:text="OGDC" />

        <TextView
            android:id="@+id/tv_constituent_meta"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_text_secondary"
            tools:text="Oil &amp; Gas Dev • Wt: 8.40%" />
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/tv_constituent_price"
        android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_constituent_change"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="142.50" />

    <!-- % Change -->
    <TextView
        android:id="@+id/tv_constituent_change"
        android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_positive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+1.79%" />

</androidx.constraintlayout.widget.ConstraintLayout>
