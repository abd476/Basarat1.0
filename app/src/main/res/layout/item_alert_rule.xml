<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Stock Symbol Badge -->
        <TextView
            android:id="@+id/tv_stock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_stock_symbol"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="LUCK"
            android:textColor="@color/color_brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status Tag / Active Label -->
        <TextView
            android:id="@+id/tv_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Active"
            android:textColor="@color/color_positive"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_stock_badge"
            app:layout_constraintStart_toEndOf="@id/tv_stock_badge"
            app:layout_constraintTop_toTopOf="@id/tv_stock_badge" />

        <!-- Active Toggle Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Condition Title -->
        <TextView
            android:id="@+id/tv_condition_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Price Rises Above"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tv_threshold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_stock_badge" />

        <!-- Threshold Value -->
        <TextView
            android:id="@+id/tv_threshold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PKR 125.50"
            android:textColor="@color/color_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_condition_title"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/divider_card"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/color_divider"
            app:layout_constraintTop_toBottomOf="@id/tv_threshold" />

        <!-- Created Date -->
        <TextView
            android:id="@+id/tv_created_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Created Sep 24, 2026"
            android:textColor="@color/color_text_tertiary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_edit_rule"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_card" />

        <!-- Edit Rule Button -->
        <ImageView
            android:id="@+id/btn_edit_rule"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Rule"
            android:padding="6dp"
            android:src="@drawable/ic_edit_alert"
            app:tint="@color/color_text_secondary"
            app:layout_constraintBottom_toBottomOf="@id/tv_created_date"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_rule"
            app:layout_constraintTop_toTopOf="@id/tv_created_date" />

        <!-- Delete Rule Button -->
        <ImageView
            android:id="@+id/btn_delete_rule"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Rule"
            android:padding="6dp"
            android:src="@drawable/ic_delete_alert"
            app:tint="@color/color_negative"
            app:layout_constraintBottom_toBottomOf="@id/tv_created_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_created_date" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
