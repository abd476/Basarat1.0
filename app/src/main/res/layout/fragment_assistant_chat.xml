<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="1dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="#111827"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:title="AI Assistant" />

    <!-- Message list area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading state -->
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="#00B894" />

        <!-- Error state -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:layout_marginTop="16dp"
                app:backgroundTint="#00B894" />

        </LinearLayout>

        <!-- Welcome state (empty new chat) -->
        <LinearLayout
            android:id="@+id/layoutWelcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_ai"
                android:contentDescription="AI"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BASARAT AI Assistant"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask me about PSX stocks, market analysis, portfolio insights, and investment strategies."
                android:textColor="#667085"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is a decision-support tool. Not investment advice."
                android:textColor="#98A2B3"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Chat messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:listitem="@layout/item_chat_message_assistant" />

        <!-- Streaming indicator overlay (shows during active streaming) -->
        <LinearLayout
            android:id="@+id/layoutStreaming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="horizontal"
            android:background="@drawable/bg_chat_bubble_assistant"
            android:padding="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BASARAT AI"
                android:textColor="#4F7CFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvStreamingContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111827"
                android:textSize="14sp"
                android:maxWidth="260dp" />

        </LinearLayout>

        <!-- Regenerate button (shows after last assistant message) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegenerate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="Regenerate"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_regenerate"
            app:iconSize="16dp"
            app:strokeColor="#E8ECEA"
            android:textColor="#667085" />

    </FrameLayout>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8ECEA" />

    <!-- Message composer -->
    <LinearLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="Ask about PSX stocks..."
            android:textColorHint="#98A2B3"
            android:textColor="#111827"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionNone"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_send_button"
            android:contentDescription="Send message"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>
