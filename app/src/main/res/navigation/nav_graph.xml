<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.fyp.basarattradeinvest.feature.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.fyp.basarattradeinvest.feature.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.fyp.basarattradeinvest.feature.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/nav_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.fyp.basarattradeinvest.feature.auth.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/nav_home"
            app:popUpTo="@id/signUpFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Navigation Destinations -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.fyp.basarattradeinvest.feature.markets.MarketDashboardFragment"
        android:label="Markets"
        tools:layout="@layout/fragment_market_dashboard">
        <action
            android:id="@+id/action_marketDashboard_to_shariahScreening"
            app:destination="@id/shariahScreeningFragment" />
        <action
            android:id="@+id/action_marketDashboard_to_stockDetail"
            app:destination="@id/stockDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_markets"
        android:name="com.fyp.basarattradeinvest.feature.markets.MarketDashboardFragment"
        android:label="Markets"
        tools:layout="@layout/fragment_market_dashboard">
        <action
            android:id="@+id/action_markets_to_shariahScreening"
            app:destination="@id/shariahScreeningFragment" />
        <action
            android:id="@+id/action_markets_to_stockDetail"
            app:destination="@id/stockDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/shariahScreeningFragment"
        android:name="com.fyp.basarattradeinvest.feature.shariah.ShariahScreeningFragment"
        android:label="Shariah Screening"
        tools:layout="@layout/fragment_shariah_screening">
        <action
            android:id="@+id/action_shariah_to_stockDetail"
            app:destination="@id/stockDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/stockDetailFragment"
        android:name="com.fyp.basarattradeinvest.feature.stock.detail.StockDetailFragment"
        android:label="Stock Detail"
        tools:layout="@layout/fragment_stock_detail">
        <argument
            android:name="symbol"
            app:argType="string"
            android:defaultValue="SARCO" />
        <action
            android:id="@+id/action_stockDetail_to_stockAnalysis"
            app:destination="@id/stockAnalysisFragment" />
    </fragment>

    <fragment
        android:id="@+id/stockAnalysisFragment"
        android:name="com.fyp.basarattradeinvest.feature.stock.analysis.StockAnalysisFragment"
        android:label="Stock Analysis"
        tools:layout="@layout/fragment_stock_analysis">
        <argument
            android:name="symbol"
            app:argType="string"
            android:defaultValue="LUCK" />
    </fragment>

</navigation>
